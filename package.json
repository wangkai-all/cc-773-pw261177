{
  "name": "blendwise-tank-farm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "罐区混料分析：名义/最坏/场景概率方案，带预留与并发确认",
  "scripts": {
    "dev": "vite",
